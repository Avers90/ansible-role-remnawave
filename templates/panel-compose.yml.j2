# {{ ansible_managed }}
# Remnawave Panel — Docker Compose
# Managed by Ansible — do not edit manually

x-common: &common
  ulimits:
    nofile:
      soft: 1048576
      hard: 1048576
  restart: always
  networks:
    - remnawave-network

x-logging: &logging
  logging:
    driver: json-file
    options:
      max-size: 100m
      max-file: "5"

x-env: &env
  env_file: .env

services:
  remnawave:
    image: remnawave/backend:{{ remnawave_panel_version }}
    container_name: remnawave
    hostname: remnawave
    <<: [*common, *logging, *env]
    ports:
      - "127.0.0.1:{{ remnawave_app_port }}:{{ remnawave_app_port }}"
      - "127.0.0.1:{{ remnawave_metrics_port }}:{{ remnawave_metrics_port }}"
    volumes:
      # Mount TLS certificates for Xray config (VLESS TLS transport)
      # Panel pushes certs to node via gRPC when referenced in Xray config
      - "{{ remnawave_cert_dir }}:/var/lib/remnawave/configs/xray/ssl:ro"
    healthcheck:
      test: ['CMD-SHELL', 'curl -sf http://localhost:{{ remnawave_metrics_port }}/health || exit 1']
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    depends_on:
      remnawave-db:
        condition: service_healthy
      remnawave-redis:
        condition: service_healthy

  remnawave-db:
    image: postgres:17.6
    container_name: remnawave-db
    hostname: remnawave-db
    <<: [*common, *logging, *env]
    environment:
      - POSTGRES_USER=postgres
      - POSTGRES_PASSWORD={{ remnawave_postgres_password_value }}
      - POSTGRES_DB=postgres
      - TZ=UTC
    ports:
      - "127.0.0.1:6767:5432"
    volumes:
      - remnawave-db-data:/var/lib/postgresql/data
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U postgres -d postgres']
      interval: 3s
      timeout: 10s
      retries: 3

  remnawave-redis:
    image: valkey/valkey:9-alpine
    container_name: remnawave-redis
    hostname: remnawave-redis
    <<: [*common, *logging]
    command: >
      valkey-server
      --save ""
      --appendonly no
      --maxmemory-policy noeviction
      --loglevel warning
    healthcheck:
      test: ['CMD', 'valkey-cli', 'ping']
      interval: 3s
      timeout: 3s
      retries: 3

networks:
  remnawave-network:
    name: remnawave-network
    driver: bridge
    external: false

volumes:
  remnawave-db-data:
    name: remnawave-db-data
    driver: local
    external: false

