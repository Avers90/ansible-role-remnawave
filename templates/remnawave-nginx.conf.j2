# {{ ansible_managed }}
# Remnawave nginx vhost
# Port {{ remnawave_nginx_fallback_port }} — Xray forwards non-VPN HTTPS traffic here via fallback
# Access restricted to loopback and RFC-1918 ranges (Docker gateway + Xray loopback)
#
# server_name routing on a single port:
#   {{ remnawave_subscription_page_domain }} → subscription page (port {{ remnawave_subscription_page_port }})
#   _                                        → panel API + decoy static site
#
# Xray inbound fallbacks should be:
#   { "dest": {{ remnawave_nginx_fallback_port }}, "xver": 0 }   ← single fallback, nginx handles routing by Host

# Common allow/deny and proxy settings shared by all server blocks
# (nginx does not support shared include blocks inline, so repeated per block)

{% if remnawave_subscription_page_enabled | bool and remnawave_subscription_page_domain | length > 0 %}
# --- Subscription Page ---
server {
    listen {{ remnawave_nginx_fallback_port }};
    listen [::]:{{ remnawave_nginx_fallback_port }};

    server_name {{ remnawave_subscription_page_domain }};

    allow 127.0.0.0/8;
    allow ::1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;

    access_log /var/log/nginx/remnawave-sub-access.log main;
    error_log  /var/log/nginx/remnawave-sub-error.log;

    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header Content-Security-Policy;
    proxy_intercept_errors on;

    # Root path — serve decoy site (subscription page returns empty on /)
    location = / {
        root {{ remnawave_site_root }};
        try_files /index.html =404;
    }

    # Dot-files inside /assets/ (e.g. /assets/.app-config-v2.json) — dynamic, not filesystem
    location ~ ^/assets/\. {
        proxy_pass         http://127.0.0.1:{{ remnawave_subscription_page_port }};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
    }

    location / {
        proxy_pass         http://127.0.0.1:{{ remnawave_subscription_page_port }};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        error_page 502 503 504 =200 /index.html;
    }

    location ~ /\. { deny all; }
}

{% endif %}
# --- Panel + decoy (catch-all) ---
server {
    listen {{ remnawave_nginx_fallback_port }} default_server;
    listen [::]:{{ remnawave_nginx_fallback_port }} default_server;

    server_name {% if remnawave_panel_enabled | bool %}{{ remnawave_domain }}{% endif %} _;

    allow 127.0.0.0/8;
    allow ::1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;

    root {{ remnawave_site_root }};
    index index.html index.htm;

    access_log {{ remnawave_site_access_log }} main;
    error_log  {{ remnawave_site_error_log }};

{% if remnawave_site_security_headers | bool %}
    add_header X-Frame-Options      "SAMEORIGIN"              always;
    add_header X-Content-Type-Options "nosniff"               always;
    add_header Referrer-Policy      "no-referrer-when-downgrade" always;

{% endif %}
    # Strip headers that break plain-HTTP access (SSH tunnel, Xray fallback)
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header Content-Security-Policy;

{% if remnawave_panel_enabled | bool %}
    location ~ ^/(assets|locales)/ {
        proxy_pass http://127.0.0.1:{{ remnawave_app_port }};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 86400;
    }

    location ~* ^/(api|dashboard|docs|scalar|openapi\.json|statics|sub) {
        proxy_pass http://127.0.0.1:{{ remnawave_app_port }};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 86400;
    }

{% endif %}
    location / {
        try_files $uri $uri/ =404;
    }

    location ~ /\. { deny all; }
}
