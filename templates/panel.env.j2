# {{ ansible_managed }}
# Remnawave Panel environment configuration
# This file is managed by Ansible — do not edit manually

### APP ###
APP_PORT={{ remnawave_app_port }}
METRICS_PORT={{ remnawave_metrics_port }}

### API ###
# Possible values: max, -1 (all cores - 1), or integer
# Do not set more than physical core count
API_INSTANCES={{ remnawave_api_instances }}

### DATABASE ###
DATABASE_URL="postgresql://postgres:{{ remnawave_postgres_password_value }}@remnawave-db:5432/postgres"

### REDIS ###
REDIS_HOST=remnawave-redis
REDIS_PORT=6379

### JWT ###
JWT_AUTH_SECRET={{ remnawave_jwt_auth_secret_value }}
JWT_API_TOKENS_SECRET={{ remnawave_jwt_api_tokens_secret_value }}

### TELEGRAM NOTIFICATIONS ###
IS_TELEGRAM_NOTIFICATIONS_ENABLED={{ remnawave_telegram_enabled | lower }}
TELEGRAM_BOT_TOKEN={{ remnawave_telegram_bot_token }}
TELEGRAM_NOTIFY_USERS={{ remnawave_telegram_notify_users }}
TELEGRAM_NOTIFY_NODES={{ remnawave_telegram_notify_nodes }}
TELEGRAM_NOTIFY_CRM={{ remnawave_telegram_notify_crm }}
TELEGRAM_NOTIFY_SERVICE={{ remnawave_telegram_notify_service }}
TELEGRAM_NOTIFY_TBLOCKER={{ remnawave_telegram_notify_tblocker }}
{% if remnawave_telegram_bot_proxy | length > 0 %}
TELEGRAM_BOT_PROXY={{ remnawave_telegram_bot_proxy }}
{% endif %}
{% if remnawave_telegram_bot_api_root | length > 0 %}
TELEGRAM_BOT_API_ROOT={{ remnawave_telegram_bot_api_root }}
{% endif %}

### FRONT_END ###
# CORS allowed origin — set to panel domain for security
FRONT_END_DOMAIN={{ remnawave_domain }}

### PANEL DOMAIN ###
# Used for generating direct links (e.g. in Telegram notifications with inline buttons)
{% if remnawave_panel_domain | length > 0 %}
PANEL_DOMAIN={{ remnawave_panel_domain }}
{% else %}
PANEL_DOMAIN={{ remnawave_domain }}
{% endif %}

### SUBSCRIPTION PUBLIC DOMAIN ###
# Domain without http/https, no trailing slash
# Used in profile-web-page-url response header and UI/API
SUB_PUBLIC_DOMAIN={{ remnawave_sub_public_domain_value }}

### SWAGGER ###
SWAGGER_PATH=/docs
SCALAR_PATH=/scalar
IS_DOCS_ENABLED={{ remnawave_swagger_enabled | lower }}

### PROMETHEUS ###
# Metrics available at http://127.0.0.1:{{ remnawave_metrics_port }}/metrics
METRICS_USER={{ remnawave_metrics_user }}
METRICS_PASS={{ remnawave_metrics_pass_value }}

### WEBHOOK ###
WEBHOOK_ENABLED={{ remnawave_webhook_enabled | lower }}
WEBHOOK_URL={{ remnawave_webhook_url }}
WEBHOOK_SECRET_HEADER={{ remnawave_webhook_secret_header_value }}

### BANDWIDTH NOTIFICATIONS ###
BANDWIDTH_USAGE_NOTIFICATIONS_ENABLED={{ remnawave_bandwidth_notifications_enabled | lower }}
BANDWIDTH_USAGE_NOTIFICATIONS_THRESHOLD={{ remnawave_bandwidth_notifications_threshold | to_json }}

### NOT CONNECTED USERS NOTIFICATION ###
NOT_CONNECTED_USERS_NOTIFICATIONS_ENABLED={{ remnawave_not_connected_notifications_enabled | lower }}
NOT_CONNECTED_USERS_NOTIFICATIONS_AFTER_HOURS={{ remnawave_not_connected_notifications_hours | to_json }}

### MISCELLANEOUS ###
# Enable HTTP request logging (useful for debugging, disabled by default)
IS_HTTP_LOGGING_ENABLED={{ remnawave_http_logging_enabled | lower }}
# JWT auth token lifetime in hours (12–168)
JWT_AUTH_LIFETIME={{ remnawave_jwt_auth_lifetime }}
# Short UUID length for subscription links (16–64)
SHORT_UUID_LENGTH={{ remnawave_short_uuid_length }}

### Database (for Postgres Docker container) ###
POSTGRES_USER=postgres
POSTGRES_PASSWORD={{ remnawave_postgres_password_value }}
POSTGRES_DB=postgres
