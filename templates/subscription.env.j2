# {{ ansible_managed }}
# Remnawave Subscription Page environment configuration
# This file is managed by Ansible — do not edit manually

APP_PORT={{ remnawave_subscription_page_port }}

### Remnawave Panel URL
# Subscription page routes requests through nginx (host gateway) instead of directly
# to the backend container. This is required because the backend's ProxyCheckMiddleware
# rejects requests without X-Forwarded-Proto: https and X-Forwarded-For headers.
# nginx (listening on 0.0.0.0:{{ remnawave_nginx_fallback_port }}) adds these headers automatically.
# Docker gateway IP (172.18.0.1 by default) is the host as seen from inside a container.
REMNAWAVE_PANEL_URL=http://{{ remnawave_docker_gateway_ip }}:{{ remnawave_nginx_fallback_port }}

### API token — create in panel: Settings → API Tokens
REMNAWAVE_API_TOKEN={{ remnawave_subscription_page_api_token }}
